# Apache Konfiguration
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Deployment-Statusdateien (.ftp-deploy-sync-state.json u. a.) nicht ausliefern (403)
    RewriteRule (^|/)\.ftp- - [F,L]

    # www.3doberberg.de -> https://3doberberg.de/ (dauerhaft, auch bei http)
    RewriteCond %{HTTP_HOST} ^www\.3doberberg\.de$ [NC]
    RewriteRule ^(.*)$ https://3doberberg.de/$1 [R=301,L]

    # http://3doberberg.de -> https://3doberberg.de/ (nur Hauptdomain, nicht test.3doberberg.de)
    RewriteCond %{HTTP_HOST} ^3doberberg\.de$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^(.*)$ https://3doberberg.de/$1 [R=301,L]

    # /index.html -> / (eine einzige URL fuer die Startseite; Query-String, z. B. ?status=, bleibt erhalten)
    RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
    RewriteRule ^index\.html$ / [R=301,L,QSA]
</IfModule>

# Upload-Grenzen (greifen nur, wenn PHP als Apache-Modul laeuft; sonst gilt .user.ini bzw. das Hosting-Panel)
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 20M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 20M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 20M
</IfModule>

<IfModule mod_headers.c>
    # Testsystem nicht indexieren lassen
    SetEnvIfNoCase Host ^test\. NOINDEX_HOST
    Header set X-Robots-Tag "noindex, nofollow" env=NOINDEX_HOST

    # Seiten immer auf Aktualitaet pruefen, Bilder und Video eine Woche cachen
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(jpg|jpeg|png|webp|mp4)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript
</IfModule>
