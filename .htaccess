# Apache Konfiguration
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    # www.3doberberg.de auf 3doberberg.de umleiten (passend zum Canonical)
    RewriteCond %{HTTP_HOST} ^www\.3doberberg\.de$ [NC]
    RewriteCond %{HTTPS} on
    RewriteRule ^(.*)$ https://3doberberg.de/$1 [R=301,L]
    RewriteCond %{HTTP_HOST} ^www\.3doberberg\.de$ [NC]
    RewriteRule ^(.*)$ http://3doberberg.de/$1 [R=301,L]
    RewriteRule ^admin$ admin/index.php [L]
    RewriteRule ^admin/$ admin/index.php [L]
    DirectoryIndex shop.html index.html index.php
    ErrorDocument 404 /404.html
    ErrorDocument 500 /500.html
</IfModule>

<IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 20M
    php_value max_execution_time 300
    php_value memory_limit 128M
</IfModule>

<IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
</IfModule>

<IfModule mod_mime.c>
    AddType application/json .json
</IfModule>

<FilesMatch "^\.(php|html|htaccess)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

<Directory "config">
    Order Allow,Deny
    Deny from all
</Directory>

<Directory "uploads">
    Order Allow,Deny
    Allow from all
</Directory>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript
</IfModule>