<!DOCTYPE html>
<html dir="{{ direction }}" lang="{{ lang }}">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>{{ title }}</title>
  <base href="{{ base }}"/>
  {% if description %}
    <meta name="description" content="{{ description }}"/>
  {% endif %}
  {% if keywords %}
    <meta name="keywords" content="{{ keywords }}"/>
  {% endif %}
  <script src="{{ jquery }}" type="text/javascript"></script>
  <link href="{{ bootstrap }}" type="text/css" rel="stylesheet" media="screen"/>
  <link href="{{ icons }}" rel="stylesheet" type="text/css"/>
  <link rel="preload" href="catalog/view/stylesheet/fonts/3doberberg/plus-jakarta-sans.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="catalog/view/stylesheet/fonts/3doberberg/fraunces-roman.woff2" as="font" type="font/woff2" crossorigin>
  <link href="{{ stylesheet }}" type="text/css" rel="stylesheet"/>
  <link href="catalog/view/stylesheet/3doberberg.css" type="text/css" rel="stylesheet"/>
  <script src="catalog/view/javascript/common.js" type="text/javascript"></script>
  {% if icon %}
    <link rel="icon" href="{{ icon }}" type="image/png">
  {% else %}
    <link rel="icon" href="image/catalog/3doberberg-logo.png" type="image/png">
  {% endif %}
  {% for style in styles %}
    <link href="{{ style.href }}" type="text/css" rel="{{ style.rel }}" media="{{ style.media }}"/>
  {% endfor %}
  {% for script in scripts %}
    <script src="{{ script.href }}" type="text/javascript"></script>
  {% endfor %}
  {% for link in links %}
    <link href="{{ link.href }}" rel="{{ link.rel }}"/>
  {% endfor %}
  {% for analytic in analytics %}
    {{ analytic }}
  {% endfor %}
</head>
<body>
<div id="container">
  <div id="alert"></div>
  <nav id="top" aria-label="Hauptnavigation">
    <a href="{{ home }}" class="nav-logo"><img src="image/catalog/3doberberg-logo.png" alt="{{ name }}" title="{{ name }}"/></a>
    <div class="nav-links">
      <a href="https://3doberberg.de/">Startseite</a>
      <a href="https://3doberberg.de/leistungen.html">Leistungen</a>
      <a href="https://3doberberg.de/ersatzteile.html">Ersatzteile</a>
      <a href="{{ home }}" class="active">Shop</a>
      <a href="https://3doberberg.de/#cta-w">Kontakt</a>
    </div>
    <ul class="nav-tools">
      <li>{{ currency }}</li>
      <li>{{ language }}</li>
      <li>
        <div class="dropdown">
          <span role="button" class="tool dropdown-toggle" data-bs-toggle="dropdown"><i class="fa-solid fa-user"></i> <span class="d-none d-xl-inline">{{ text_account }}</span></span>
          <ul class="dropdown-menu dropdown-menu-end">
            {% if not logged %}
              <li><a href="{{ register }}" class="dropdown-item">{{ text_register }}</a></li>
              <li><a href="{{ login }}" class="dropdown-item">{{ text_login }}</a></li>
            {% else %}
              <li><a href="{{ account }}" class="dropdown-item">{{ text_account }}</a></li>
              <li><a href="{{ order }}" class="dropdown-item">{{ text_order }}</a></li>
              <li><a href="{{ transaction }}" class="dropdown-item">{{ text_transaction }}</a></li>
              <li><a href="{{ download }}" class="dropdown-item">{{ text_download }}</a></li>
              <li><a href="{{ logout }}" class="dropdown-item">{{ text_logout }}</a></li>
            {% endif %}
          </ul>
        </div>
      </li>
      <li><a href="{{ wishlist }}" id="wishlist-total" class="tool" title="{{ text_wishlist }}"><i class="fa-solid fa-heart"></i> <span class="d-none d-xl-inline">{{ text_wishlist }}</span></a></li>
      <li><div id="cart">{{ cart }}</div></li>
    </ul>
  </nav>
  <header class="shop-head">
    <div class="container">{{ search }}</div>
  </header>
  <main>
    {{ menu }}
</main>
